{% extends 'base.html.twig' %}

{% block navigation %}
    {% include 'site/navigation.html.twig' %}
{% endblock %}

{% block body %}
    <div style="margin-bottom: 15px;">
        {% if user is not defined or user == null %}
            <b>Welcome to the Ultimate-Warfare forums!</b>
            <br />
            You are currently not logged in, you can only view the forums now. <a href="{{ path('Site/Login') }}">Click here to login!</a>
        {% else %}
            You are logged in as <b>{{ user.username }}</b>. Back to <a href="{{ path('Game/WorldMap') }}">Game</a>?
        {% endif %}
    </div>

    {% include 'flashes.html.twig' %}

    {% block content %}{% endblock %}
{% endblock %}
