<div class="modal fade" id="selectOperationModal" tabindex="-1" aria-labelledby="selectOperationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="selectOperationModalLabel">Select Operation &mdash; Target <span id="operationTargetInfo"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="operationsContainer" style="max-height: 400px; overflow-y: auto;">
                    <div class="build-loading">Loading operations...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
