<div class="modal fade" id="attackUnitsModal" tabindex="-1" aria-labelledby="attackUnitsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-build">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="attackUnitsModalLabel">Select Units to Attack &mdash; <span id="attackUnitsTarget"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="attackUnitsInfo" style="margin-bottom: 15px; font-size: 13px;"></div>
                <div id="attackUnitsContainer" class="build-units-container">
                    <div class="build-loading">Loading units...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmAttackUnitsBtn">&#9876; Send Attack</button>
            </div>
        </div>
    </div>
</div>
