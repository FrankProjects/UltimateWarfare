<div class="modal fade" id="operationUnitsModal" tabindex="-1" aria-labelledby="operationUnitsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="operationUnitsModalLabel">Launch Operation &mdash; <span id="operationUnitsName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="operationUnitsInfo" style="margin-bottom: 15px; font-size: 13px;"></div>
                <div id="operationUnitsContainer">
                    <div class="build-loading">Loading...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn" id="confirmOperationBtn" style="background: #9c27b0; color: #f3e6c1;">Launch Operation</button>
            </div>
        </div>
    </div>
</div>
