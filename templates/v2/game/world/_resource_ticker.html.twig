{# Projected to now (stored resources are only written on sync); resource-ticker.js keeps them counting #}
{% set now = 'now'|date('U') %}
{% set currentResources = player_resources(player, now) %}
<div class="resource-ticker" data-server-time="{{ now }}">
    {% set resources = [
        { name: 'Cash', icon: 'resource_cash.svg', key: 'cash' },
        { name: 'Wood', icon: 'resource_wood.svg', key: 'wood' },
        { name: 'Food', icon: 'resource_grain_wheat.svg', key: 'food' },
        { name: 'Steel', icon: 'resource_steel.svg', key: 'steel' },
    ] %}

    {% for res in resources %}
        {% set amount = attribute(currentResources, res.key) %}
        {% set income = attribute(player.income, res.key) %}
        {% set upkeep = attribute(player.upkeep, res.key) %}
        {% set net = income - upkeep %}
        <div class="resource-item" data-resource="{{ res.key }}" data-amount="{{ amount }}" data-rate="{{ net }}">
            <img src="{{ asset('images/icons/' ~ res.icon) }}" alt="{{ res.name }}" class="resource-icon">
            <div class="resource-details">
                <span class="resource-amount">{{ amount|number_format(0, '.', ',') }}</span>
                <span class="resource-income {% if net >= 0 %}positive{% else %}negative{% endif %}">
                    {% if net >= 0 %}+{% endif %}{{ net|number_format(0, '.', ',') }}/h
                </span>
            </div>
        </div>
    {% endfor %}
</div>
