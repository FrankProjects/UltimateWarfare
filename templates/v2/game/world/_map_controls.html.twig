<div class="map-controls">
    <div class="nav-dropdown">
        <button type="button" class="nav-dropdown-btn" id="navMenuBtn">&#9776;</button>
        <div class="nav-dropdown-content" id="navMenu">
            <a href="#" id="navReportsBtn">Reports</a>
            <a href="#" id="navRegionsBtn">Regions</a>
            <a href="#" id="navConstructionBtn">Construction</a>
            <a href="#" id="navFleetsBtn">Fleets</a>
            <a href="#" id="navMarketBtn">Market</a>
            <a href="#" id="navResearchBtn">Research</a>
            <a href="#" id="navFederationBtn">Federation</a>
            <a href="#" id="navRankingsBtn">Rankings</a>
            <a href="#" id="navStatisticsBtn">Statistics</a>
        </div>
    </div>
    {% include 'v2/game/world/_resource_ticker.html.twig' %}
    <div class="profile-dropdown">
        <button type="button" class="profile-icon" id="profileDropdownBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
            </svg>
        </button>
        <div class="dropdown-content" id="profileDropdown">
            <a href="#" id="worldsBtn">Worlds</a>
            <a href="#" id="profileBtn">Profile</a>
            <a href="{{ path('Guide') }}">Guide</a>
            <a href="#" id="messagesBtn">Messages</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('Admin') }}">Admin Panel</a>
            {% endif %}
            <a href="{{ path('Site/Logout') }}">Log Off</a>
        </div>
    </div>
</div>
