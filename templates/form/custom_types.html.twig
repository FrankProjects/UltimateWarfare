{% block captcha_row %}
    <div class="mb-3">
        <label class="form-label">{{ 'captcha.prompt'|trans({}, 'messages') }}</label>
        <div class="d-flex align-items-center gap-3 mb-2">
            <img id="captcha-image" src="{{ path('Site/Captcha') }}" alt="{{ 'captcha.alt'|trans({}, 'messages') }}" style="height: 70px;">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('captcha-image').src='{{ path('Site/Captcha') }}?t='+Date.now()">&#8635; {{ 'captcha.refresh'|trans({}, 'messages') }}</button>
        </div>
        {{ form_widget(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}
