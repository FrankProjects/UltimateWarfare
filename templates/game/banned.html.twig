{% extends 'noBarBase.html.twig' %}

{% block title %}Ultimate Warfare - Account banned{% endblock title %}

{% block content %}
    <form action="{{ path('Game/Banned') }}" method="post">
        <div class="uw-card">
            <div class="uw-card-header">Banned Account Recovery</div>
            <div class="uw-card-body">
                <p>Your account has been banned because you did something against the rules. To regain access to your account, explain below why you did something against the rules.</p>
                <p>We will try to take a look at your banned account recovery request as soon as possible. If this was a mistake, we apologize!</p>

                <div class="mb-3">
                    <textarea name="post" class="form-control" rows="9">{{ unbanRequest.post }}</textarea>
                </div>

                <button class="btn btn-primary" type="submit">Send recovery request</button>
            </div>
        </div>
    </form>
{% endblock %}
