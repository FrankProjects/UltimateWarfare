<div class="uw-card">
    <div class="uw-card-body">
        <div class="row">
            <div class="col-3">
                <div>Name: {{ post.user.username }}</div>
                {% if 'ROLE_ADMIN' in post.user.roles %}
                    <p><b>Forum Moderator</b></p>
                {% endif %}
                <div>
                    Date/Time:<br/>
                    {{ post.createDateTime|date("Y-m-d H:i:s") }}
                </div>
            </div>
            <div class="col-9">
                {{ post.content|nl2br }}
                {% if post.editUser %}
                    <br/><br/><i> Last edited by: {{ post.editUser.username }}</i>
                {% endif %}

                {% if user != null and post.user.id == user.id or is_granted('ROLE_ADMIN') %}
                    <br/>
                    <br/>
                    <form method="POST" action="{{ path('Forum/Post/Remove', {'postId': post.id}) }}" style="display:inline">
                        <button type="submit" class="btn btn-primary" title="Delete">Delete</button>
                    </form>
                    - <a class="btn btn-primary" href="{{ path('Forum/Post/Edit', {'postId': post.id}) }}" title="Edit">Edit</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
<br/>
