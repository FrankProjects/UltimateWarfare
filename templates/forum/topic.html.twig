{% extends 'forumBase.html.twig' %}
{% block content %}
    {% trans_default_domain 'forum' %}

    <div class="text-center">
        <a href="{{ path('Forum') }}">{{ 'label.forum'|trans }}</a> -
        <a href="{{ path('Forum/Category', {'categoryId': topic.category.value}) }}">{{ 'label.topics'|trans }}</a>
    </div>

    {% if is_granted('ROLE_ADMIN') %}
        {% if topic.sticky %}
            <form method="POST" action="{{ path('Forum/Topic/Unsticky', {'topicId': topic.id}) }}" style="display:inline">
                <button type="submit" class="btn btn-primary">{{ 'action.topic.unsticky'|trans }}</button>
            </form>
        {% else %}
            <form method="POST" action="{{ path('Forum/Topic/Sticky', {'topicId': topic.id}) }}" style="display:inline">
                <button type="submit" class="btn btn-primary">{{ 'action.topic.sticky'|trans }}</button>
            </form>
        {% endif %}
    {% endif %}

    <div class="uw-card">
        <div class="uw-card-header">
            {% if topic.sticky == 1 %}
                <span style="color:#CC0000">Sticky </span>{{ topic.title }}
            {% else %}
                {{ topic.title }}
            {% endif %}
        </div>
        <div class="uw-card-body">
            <div class="row">
                <div class="col-3">
                    <div>{{ 'label.name'|trans }}: {{ topic.user.username }}</div>
                    {% if 'ROLE_ADMIN' in topic.user.roles %}
                        <p><b>Forum Moderator</b></p>
                    {% endif %}
                    <div>
                        {{ 'label.date'|trans }}:<br />
                        {{ topic.createDateTime|date("Y-m-d H:i:s") }}
                    </div>
                </div>
                <div class="col-9">
                    {{ topic.content|nl2br }}

                    {% if topic.editUser != null %}
                        <br/><br/><i> Last edited by: {{ topic.editUser.username }}</i>
                    {% endif %}

                    {% if user != null and user.id == topic.user.id or is_granted('ROLE_ADMIN') %}
                        <br />
                        <br />
                        <form method="POST" action="{{ path('Forum/Topic/Remove', {'topicId': topic.id}) }}" style="display:inline">
                            <button type="submit" class="btn btn-primary">{{ 'action.topic.delete'|trans }}</button>
                        </form> -
                        <a class="btn btn-primary" href="{{ path('Forum/Topic/Edit', {'topicId': topic.id}) }}">{{ 'action.topic.edit'|trans }}</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <br />

    {% for post in topic.posts %}
        {% include 'forum/post.html.twig' %}
    {% endfor %}

    {% if user != null %}
        {{ form_start(form) }}
        <div class="uw-card">
            <div class="uw-card-header">{{ 'label.add_reaction'|trans }}</div>
            <div class="uw-card-body">
                {{ form_widget(form.content) }}
                <div class="mt-2">
                    {{ form_row(form.submit) }}
                </div>
            </div>
        </div>
        {{ form_end(form) }}
    {% endif %}
{% endblock %}
