{% extends 'forumBase.html.twig' %}

{% block title %}Ultimate Warfare - Forum{% endblock title %}

{% block content %}
    <div class="uw-card">
        <div class="uw-card-header">The Forums</div>
        <div class="uw-card-body">
            <table class="table text-center">
                <tr>
                    <td width="20"><strong>#</strong></td>
                    <td class="text-start" width="480"><strong>Forum</strong></td>
                    <td width="100"><strong>Topics</strong></td>
                    <td class="text-start" width="300"><strong>Last topic</strong></td>
                </tr>

                {% for category in categories %}
                    {% set lastTopic = lastTopics[category.value] %}
                    <tr>
                        <td>{{ category.value }}</td>
                        <td class="text-start"><a href="{{ path('Forum/Category', {'categoryId': category.value}) }}">{{ category.title }}</a></td>
                        <td>{{ topicCounts[category.value] }}</td>
                        {% if lastTopic == null %}
                            <td class="text-start">No topics yet</td>
                        {% else %}
                            <td class="text-start">{{ lastTopic.createDateTime|date("Y-m-d H:i:s") }} by {{ lastTopic.user.username }}</td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
