{% extends 'forumBase.html.twig' %}
{% block content %}
    {% trans_default_domain 'forum' %}

    <div class="text-center">
        <a href="{{ path('Forum') }}">{{ 'label.forum'|trans }}</a> -
        <a href="{{ path('Forum/Category', {'categoryId': topic.category.value}) }}">{{ 'label.topics'|trans }}</a>
    </div>

    {{ form_start(form) }}
    <div class="uw-card">
        <div class="uw-card-header">{{ 'action.topic.create'|trans }}</div>
        <div class="uw-card-body">
            <div class="mb-3">
                <label>{{ 'label.title'|trans }}</label>
                {{ form_widget(form.title) }}
            </div>
            <div class="mb-3">
                {{ form_widget(form.content) }}
            </div>
            {% if is_granted('ROLE_MODERATOR') %}
                <div class="mb-3">
                    {{ form_label(form.sticky) }}
                    {{ form_widget(form.sticky) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.closed) }}
                    {{ form_widget(form.closed) }}
                </div>
            {% endif %}
            <div>
                {{ form_row(form.submit) }}
            </div>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
