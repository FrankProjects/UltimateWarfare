{% extends 'admin.html.twig' %}

{% block title %}ADMIN - World{% endblock title %}

{% block content %}
    <div class="uw-card">
        <div class="uw-card-header">World Generator</div>
        <div class="uw-card-body">
            {{ form_start(form) }}
                {{ form_row(form.seed) }}
                {{ form_row(form.size) }}
                {{ form_row(form.deepWaterLevel) }}
                {{ form_row(form.waterLevel) }}
                {{ form_row(form.shallowWaterLevel) }}
                {{ form_row(form.sandLevel) }}
                {{ form_row(form.grasslandLevel) }}
                {{ form_row(form.forestLevel) }}
                {{ form_row(form.hillsLevel) }}

                <div class="world-generator-actions">
                    {% if map is empty %}
                        {{ form_widget(form.generate) }}
                        {% do form.save.setRendered() %}
                    {% else %}
                        {{ form_widget(form.generate, {label: 'label.regenerate'}) }}
                        {{ form_widget(form.save) }}
                    {% endif %}
                </div>
            {{ form_end(form) }}

            {% if map is not empty %}
                <div class="world-generator-map" style="--map-size: {{ map|length }};">
                {# map is indexed as map[x][y]; render y as rows and x as columns, like the world image #}
                {% for y in map|first|keys %}
                    {% for x in map|keys %}
                        {% set mapItem = map[x][y] %}
                        {% if mapItem < form.deepWaterLevel.vars.value / 100 %}
                            <div class="terrain-deep-water"></div>
                        {% elseif mapItem < form.waterLevel.vars.value / 100 %}
                            <div class="terrain-water"></div>
                        {% elseif mapItem < form.shallowWaterLevel.vars.value / 100 %}
                            <div class="terrain-shallow-water"></div>
                        {% elseif mapItem < form.sandLevel.vars.value / 100 %}
                            <div class="terrain-sand"></div>
                        {% elseif mapItem < form.grasslandLevel.vars.value / 100 %}
                            <div class="terrain-grassland"></div>
                        {% elseif mapItem < form.forestLevel.vars.value / 100 %}
                            <div class="terrain-forest"></div>
                        {% elseif mapItem < form.hillsLevel.vars.value / 100 %}
                            <div class="terrain-hills"></div>
                        {% else %}
                            <div class="terrain-mountain"></div>
                        {% endif %}
                    {% endfor %}
                {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
