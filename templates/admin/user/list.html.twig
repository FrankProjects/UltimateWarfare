{% extends 'admin.html.twig' %}

{% block title %}ADMIN - User list{% endblock title %}

{% block content %}
    <p class="text-center btn-group">
        <a href="{{ path('Admin/User/List') }}" class="btn btn-primary {{ app.request.attributes.get('filter') == '' ? 'active' : '' }}">All</a>
        <a href="{{ path('Admin/User/List', {'filter': 'email-verified'}) }}" class="btn btn-primary {{ app.request.attributes.get('filter') == 'email-verified' ? 'active' : '' }}">Email verified</a>
        <a href="{{ path('Admin/User/List', {'filter': 'email-unverified'}) }}" class="btn btn-primary {{ app.request.attributes.get('filter') == 'email-unverified' ? 'active' : '' }}">Email unverified</a>
        <a href="{{ path('Admin/User/List', {'filter': 'banned'}) }}" class="btn btn-primary {{ app.request.attributes.get('filter') == 'banned' ? 'active' : '' }}">Banned</a>
    </p>
    <div class="uw-card">
        <div class="uw-card-header">User list</div>
        <div class="uw-card-body">
            <table class="table text-center" style="table-layout: fixed; width: 100%;">
                <colgroup>
                    <col style="width: 14%;">
                    <col style="width: 22%;">
                    <col style="width: 7%;">
                    <col style="width: 19%;">
                    <col style="width: 13%;">
                    <col style="width: 13%;">
                    <col style="width: 12%;">
                </colgroup>
                <tr>
                    <td>Username</td>
                    <td>Email</td>
                    <td>Email verified</td>
                    <td>Players</td>
                    <td>Signup</td>
                    <td>Last seen</td>
                    <td>Action</td>
                </tr>
                {% for user in users %}
                    <tr>
                        <td style="overflow-wrap: break-word;">
                            {{ user.username }}
                        </td>
                        <td style="overflow-wrap: break-word;">
                            {{ user.email }}
                        </td>
                        <td>
                            {% if user.emailVerified %}
                                <span class="good">Yes</span>
                            {% else %}
                                <span class="bad">No</span>
                            {% endif %}
                        </td>
                        <td style="overflow-wrap: break-word;">
                            {% for player in user.players %}
                                <p>
                                    {{ player.name }} ({{ player.world.name }})
                                </p>
                            {% endfor %}
                        </td>
                        <td>
                            {{ user.signedUpAt|date("Y-m-d") }}
                        </td>
                        <td>
                            {% if user.lastSeenAt is not null %}
                                {{ user.lastSeenAt|date("Y-m-d") }}
                            {% endif %}
                        </td>
                        <td>
                            <a class="btn btn-primary" href="{{ path('Admin/User/Read', {'userId': user.id}) }}">View</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7">No users....</td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
