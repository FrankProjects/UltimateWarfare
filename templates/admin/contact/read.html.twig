{% extends 'admin.html.twig' %}

{% block title %}ADMIN - Contact{% endblock title %}

{% block content %}
    <div class="uw-card">
        <div class="uw-card-header">Contact</div>
        <div class="uw-card-body">
            <table class="table text-center">
                <tr>
                    <td width="150">Name</td>
                    <td width="150">Email</td>
                    <td width="300">Subject</td>
                    <td width="50">Date</td>
                    <td width="50">Action</td>
                </tr>
                <tr>
                    <td>
                        {{ contact.name }}
                    </td>
                    <td>
                        {{ contact.email }}
                    </td>
                    <td>
                        {{ contact.subject }}
                    </td>
                    <td>
                        {{ contact.createDateTime|date("Y-m-d H:i:s") }}
                    </td>
                    <td>
                        <form method="POST" action="{{ path('Admin/Contact/Remove', {'contactId': contact.id}) }}" style="display:inline">
                            <button type="submit" class="btn btn-danger"><b>Remove</b></button>
                        </form>
                    </td>
                </tr>
                <tr>
                    <td colspan="5">
                        {{ contact.message }}
                    </td>
                </tr>
            </table>
        </div>
    </div>
{% endblock %}
