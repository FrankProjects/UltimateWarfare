{% extends 'admin.html.twig' %}

{% block title %}ADMIN - Contact{% endblock title %}

{% block content %}
    <div class="uw-card">
        <div class="uw-card-header">Contact</div>
        <div class="uw-card-body">
            <table class="table text-center">
                <tr>
                    <td>Name</td>
                    <td>Email</td>
                    <td>Subject</td>
                    <td>Date</td>
                    <td>Action</td>
                </tr>
                <tr>
                    <td class="text-break">
                        {{ contact.name }}
                    </td>
                    <td class="text-break">
                        {{ contact.email }}
                    </td>
                    <td class="text-break">
                        {{ contact.subject }}
                    </td>
                    <td>
                        {{ contact.createDateTime|date("Y-m-d H:i:s") }}
                    </td>
                    <td>
                        <form method="POST" action="{{ path('Admin/Contact/Remove', {'contactId': contact.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_contact_remove_' ~ contact.id) }}">
                            <button type="submit" class="btn btn-danger btn-sm"><b>Remove</b></button>
                        </form>
                    </td>
                </tr>
                <tr>
                    <td colspan="5" class="text-start text-break">
                        {{ contact.message|nl2br }}
                    </td>
                </tr>
            </table>
        </div>
    </div>
{% endblock %}
