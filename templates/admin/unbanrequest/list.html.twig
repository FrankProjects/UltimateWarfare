{% extends 'admin.html.twig' %}

{% block title %}ADMIN - Unban requests{% endblock title %}

{% block content %}
    <div class="uw-card">
        <div class="uw-card-header">Unban requests</div>
        <div class="uw-card-body">
            <table class="table text-center">
                <tr>
                    <td width="150">Username</td>
                    <td width="450">Message</td>
                    <td width="100">Action</td>
                </tr>
                {% for unbanRequest in unbanRequests %}
                    <tr>
                        <td>
                            {{ unbanRequest.user.username }}
                        </td>
                        <td>
                            {{ unbanRequest.post }}
                        </td>
                        <td>
                            <form method="POST" action="{{ path('Admin/UnbanRequest/Unban', {'unbanRequestId': unbanRequest.id}) }}" style="display:inline">
                                <button type="submit" class="btn btn-primary"><b>Unban</b></button>
                            </form><br />
                            <form method="POST" action="{{ path('Admin/UnbanRequest/Remove', {'unbanRequestId': unbanRequest.id}) }}" style="display:inline">
                                <button type="submit" class="btn btn-danger"><b>Remove</b></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">No unban requests....</td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
