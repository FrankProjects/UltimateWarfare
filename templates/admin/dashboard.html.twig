{% extends 'admin.html.twig' %}

{% block title %}ADMIN - Dashboard{% endblock title %}

{% block content %}
    <div class="uw-card">
        <div class="uw-card-header">Dashboard</div>
        <div class="uw-card-body">
            <p>
                Total users: <span class="badge bg-primary">{{ userCount }}</span>
            </p>
            <p>
                Users active in last 24 hours: <span class="badge bg-primary">{{ loggedInCount }}</span>
            </p>
        </div>
    </div>
{% endblock %}
