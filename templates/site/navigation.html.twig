<ul class="navbar-nav ms-auto">
    <li class="nav-item">
        <a class="nav-link" href="{{ path('Site/Homepage') }}">{{ 'label.home'|trans({}, 'navigation') }}</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="{{ path('Site/Login') }}">{{ 'label.login'|trans({}, 'navigation') }}</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="{{ path('Site/Register') }}">{{ 'label.register'|trans({}, 'navigation') }}</a>
    </li>
    {% if uw_forum_enabled == true %}
        <li class="nav-item">
            <a class="nav-link" href="{{ path('Forum') }}">{{ 'label.forum'|trans({}, 'navigation') }}</a>
        </li>
    {% endif %}
    <li class="nav-item">
        <a class="nav-link" href="{{ path('Guide') }}">{{ 'label.guide'|trans({}, 'navigation') }}</a>
    </li>
    <li class="nav-item">
        <span class="lang-switch">
            <a href="{{ path(app.request.attributes.get('_route', 'Site/Homepage'), app.request.attributes.get('_route_params', {})|merge({'_locale': 'nl'})) }}">
                <img src="{{ asset('images/flag/nl.svg') }}" alt="Dutch" height="20" width="30" />
            </a>
            <a href="{{ path(app.request.attributes.get('_route', 'Site/Homepage'), app.request.attributes.get('_route_params', {})|merge({'_locale': 'en'})) }}">
                <img src="{{ asset('images/flag/en.svg') }}" alt="English" height="20" width="30" />
            </a>
        </span>
    </li>
</ul>
