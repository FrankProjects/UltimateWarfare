{% extends 'site.html.twig' %}
{% trans_default_domain 'site' %}

{% block title %}{{ 'community.title'|trans }}{% endblock title %}

{% block content %}
    <div class="uw-card">
        <div class="uw-card-header">{{ 'community.header'|trans }}</div>
        <div class="uw-card-body text-center">
            <p>{{ 'community.intro'|trans }}</p>
            <p>
                <a class="btn btn-primary" href="https://github.com/FrankProjects/UltimateWarfare">{{ 'community.github_cta'|trans }}</a>
            </p>

            <h3>{{ 'community.support.heading'|trans }}</h3>
            <p>{{ 'community.support.paragraph_1'|trans }}</p>
            <p>{{ 'community.support.paragraph_2'|trans }}</p>
            <p>
                <a href="https://www.paypal.me/frankschreuder"><img src="{{ asset('images/donate.gif') }}" alt="{{ 'community.support.donate_alt'|trans }}" /></a>
            </p>
        </div>
    </div>
{% endblock %}
