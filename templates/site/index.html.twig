{% extends 'site.html.twig' %}
{% trans_default_domain 'homepage' %}

{% block title %}{{ 'title'|trans }}{% endblock %}

{% block content %}
    <div class="uw-hero" style="background-image: url('{{ asset('images/uw_background.jpg') }}');">
        <div class="uw-hero-overlay">
            <h1>Ultimate Warfare</h1>
            <p class="tagline">{{ 'hero.tagline'|trans }}</p>
            <a class="btn-cta" href="{{ path('Site/Register') }}">{{ 'hero.cta'|trans }}</a>
        </div>
    </div>

    <div class="features-grid">
        <div class="feature-item">
            <strong>{{ 'features.free_to_play.title'|trans }}</strong>
            <span>{{ 'features.free_to_play.text'|trans }}</span>
        </div>
        <div class="feature-item">
            <strong>{{ 'features.pvp.title'|trans }}</strong>
            <span>{{ 'features.pvp.text'|trans }}</span>
        </div>
        <div class="feature-item">
            <strong>{{ 'features.world_map.title'|trans }}</strong>
            <span>{{ 'features.world_map.text'|trans }}</span>
        </div>
        <div class="feature-item">
            <strong>{{ 'features.strategy.title'|trans }}</strong>
            <span>{{ 'features.strategy.text'|trans }}</span>
        </div>
    </div>
{% endblock %}
