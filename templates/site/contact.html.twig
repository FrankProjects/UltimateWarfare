{% extends 'site.html.twig' %}
{% trans_default_domain 'site' %}

{% block title %}{{ 'contact_page.title'|trans }}{% endblock title %}

{% block content %}
    <div class="form-card-wrapper">
        <div class="uw-card">
            <div class="uw-card-header">{{ 'contact_page.header'|trans }}</div>
            <div class="uw-card-body">
                <p class="text-center">{{ 'contact_page.intro'|trans }}</p>

                {{ form_start(form) }}
                {{ form_widget(form) }}
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
