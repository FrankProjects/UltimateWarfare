{% extends 'site.html.twig' %}
{% trans_default_domain 'site' %}

{% block title %}{{ 'about.title'|trans }}{% endblock title %}

{% block content %}
    <div class="uw-card">
        <div class="uw-card-header">{{ 'about.header'|trans }}</div>
        <div class="uw-card-body">
            <p>{{ 'about.intro'|trans }}</p>

            <h3>{{ 'about.storyline.heading'|trans }}</h3>
            <p>{{ 'about.storyline.paragraph_1'|trans }}</p>
            <p>{{ 'about.storyline.paragraph_2'|trans }}</p>
            <p>{{ 'about.storyline.paragraph_3'|trans }}</p>
            <p>{{ 'about.storyline.paragraph_4'|trans }}</p>
            <p>{{ 'about.storyline.paragraph_5'|trans }}</p>

            <h3>{{ 'about.team.heading'|trans }}</h3>
            <p>{{ 'about.team.paragraph_1'|trans }}</p>
            <p>
                {{ 'about.team.paragraph_2'|trans({'%linkStart%': '<a href="https://frankprojects.com">', '%linkEnd%': '</a>'})|raw }}
            </p>

            <h3>{{ 'about.contact.heading'|trans }}</h3>
            <p>
                {{ 'about.contact.paragraph'|trans({'%linkStart%': '<a href="' ~ url('Site/Contact') ~ '">', '%linkEnd%': '</a>'})|raw }}
            </p>
        </div>
    </div>
{% endblock %}
