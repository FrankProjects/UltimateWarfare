{% extends 'site.html.twig' %}
{% trans_default_domain 'register' %}

{% block title %}{{ 'page.title'|trans }}{% endblock title %}

{% block content %}
    <div class="form-card-wrapper">
        <div class="uw-card">
            <div class="uw-card-header">{{ 'page.header'|trans }}</div>
            <div class="uw-card-body">
                {{ form_start(form) }}
                {{ form_widget(form) }}
                {{ form_end(form) }}

                <p style="margin-top: 12px; color: #999; font-size: 13px;">
                    {{ 'page.help_text'|trans }}
                </p>
            </div>
        </div>
    </div>
{% endblock %}
