{% extends 'site.html.twig' %}
{% trans_default_domain 'reset_password' %}

{% block title %}{{ 'request.title'|trans }}{% endblock title %}

{% block content %}
    <div class="form-card-wrapper">
        <div class="uw-card">
            <div class="uw-card-header">{{ 'request.header'|trans }}</div>
            <div class="uw-card-body">
                <p>{{ 'request.intro'|trans }}</p>

                <form method="post" action="{{ url('Site/ResetPassword') }}">
                    <div class="mb-3">
                        <label for="email" class="form-label">{{ 'label.email'|trans }}</label>
                        <input type="text" class="form-control" id="email" name="email" />
                    </div>
                    <button class="btn btn-primary w-100" type="submit">{{ 'request.submit'|trans }}</button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
