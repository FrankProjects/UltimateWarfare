{% extends 'site/guideBase.html.twig' %}

{% from 'site/guide/_unit_resources.html.twig' import cost_section, income_section, upkeep_section, build_time %}

{% block content %}
    <div class="guide-tabs">
        {% for cat in gameUnitCategories %}
            <a href="{{ path('Guide/ListUnits', {'gameUnitCategoryId': cat.value}) }}"
               class="guide-tab{% if cat == gameUnitCategory %} active{% endif %}">
                {{ cat.label }}
            </a>
        {% endfor %}
    </div>

    <div class="guide-units-grid">
        {% for gameUnit in gameUnits %}
            <div class="guide-unit-card">
                <img src="{{ asset('images/' ~ gameUnit.gameUnitCategory.imageDir ~ gameUnit.image) }}"
                     alt="{{ gameUnit.name }}" class="guide-unit-image">
                <div class="guide-unit-name">
                    <a href="{{ path('Guide/GameUnit', {'gameUnitId': gameUnit.gameUnitEnum.value}) }}">
                        {{ gameUnit.name }}
                    </a>
                </div>
                <div class="guide-unit-description">{{ gameUnit.description }}</div>
                <div class="guide-unit-details">
                    {{ cost_section(gameUnit.cost) }}
                    {{ income_section(gameUnit.income) }}
                    {{ upkeep_section(gameUnit.upkeep) }}
                    {{ build_time(gameUnit.timestamp) }}
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
