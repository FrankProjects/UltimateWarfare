<!DOCTYPE HTML>
<html lang="en">
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <meta name="description" content="Ultimate Warfare is a free browser based multiplayer strategy game with over 2000 registered accounts. Join the battle and compete with thousands of others for world domination!" />
        <meta name="keywords" content="Ultimate Warfare, online, game, war, multiplayer, strategy, wargames, role-playing, rpg, browser game, battles, domination, world map" />
        <meta name="author" content="Frank Schreuder" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{% block title %}Ultimate Warfare - Online multiplayer strategy game{% endblock %}</title>
        <link rel="stylesheet" type="text/css" media="all" href="{{ asset('css/bootstrap.min.css') }}" >
        <link rel="stylesheet" type="text/css" media="all" href="{{ asset('css/main.css') }}" />
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />
        <script src="{{ asset('js/popper.min.js') }}"></script>
        <script src="{{ asset('js/bootstrap.min.js') }}"></script>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand-lg">
            <div class="container" style="max-width: 960px;">
                <a class="navbar-brand" href="{{ path('Site/Homepage') }}">Ultimate Warfare</a>
                {% block navbar_controls %}
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#siteNav" aria-controls="siteNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="siteNav">
                        {% block navigation %}{% endblock %}
                    </div>
                {% endblock %}
            </div>
        </nav>

        <div class="site-content">
            {% block body %}{% endblock %}
        </div>

        <footer class="site-footer">
            <div class="container">
                <p>
                    <a href="{{ path('Site/About') }}">About</a> &middot;
                    <a href="{{ path('Site/Contact') }}">Contact</a> &middot;
                    <a href="{{ path('Site/Community') }}">Community</a>
                </p>
                <p>copyright &copy; 2006 - 2026 ultimate-warfare.com</p>
            </div>
        </footer>
    </body>
</html>
