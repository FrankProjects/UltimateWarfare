<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="FrankProjects\UltimateWarfare\Entity\User" table="user">
    <id name="id" type="integer" column="id">
      <generator strategy="IDENTITY"/>
    </id>
    <field name="username" column="username" length="180" unique="true"/>
    <field name="email" column="email" length="180" unique="true"/>
    <field name="emailVerified" type="boolean" column="email_verified">
      <options>
        <option name="default">0</option>
      </options>
    </field>
    <field name="password" column="password" length="255"/>
    <field name="lastSeenAt" type="datetime" column="last_seen_at" nullable="true"/>
    <field name="lastSeenIp" column="last_seen_ip" length="45" nullable="true"/>
    <field name="emailVerificationToken" column="email_verification_token" length="180" unique="true" nullable="true"/>
    <field name="passwordResetToken" column="password_reset_token" length="180" unique="true" nullable="true"/>
    <field name="passwordResetRequestedAt" type="datetime" column="password_reset_requested_at" nullable="true"/>
    <field name="roles" type="json" column="roles">
      <options>
        <option name="fixed"/>
      </options>
    </field>
    <field name="signedUpAt" type="datetime" column="signed_up_at"/>
    <field name="banned" type="boolean" column="banned">
      <options>
        <option name="default">0</option>
      </options>
    </field>
    <field name="forumBanned" type="boolean" column="forum_banned">
      <options>
        <option name="default">0</option>
      </options>
    </field>
    <one-to-many field="players" target-entity="FrankProjects\UltimateWarfare\Entity\Player" mapped-by="user"/>
    <one-to-many field="topics" target-entity="FrankProjects\UltimateWarfare\Entity\Topic" mapped-by="user"/>
    <one-to-many field="topicsEdited" target-entity="FrankProjects\UltimateWarfare\Entity\Topic" mapped-by="editUser"/>
    <one-to-many field="posts" target-entity="FrankProjects\UltimateWarfare\Entity\Post" mapped-by="user"/>
    <one-to-many field="postsEdited" target-entity="FrankProjects\UltimateWarfare\Entity\Post" mapped-by="editUser"/>
  </entity>
</doctrine-mapping>
