<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="FrankProjects\UltimateWarfare\Entity\BattleSummary" table="battle_summary">
    <id name="id" type="integer" column="id">
      <generator strategy="IDENTITY"/>
    </id>
    <field name="battleLog" type="text" column="battle_log" length="65535">
      <options>
        <option name="fixed"/>
      </options>
    </field>
    <field name="attackerWon" type="boolean" column="attacker_won"/>
    <field name="lostUnits" type="json" column="lost_units" nullable="true"/>
    <field name="timestamp" type="integer" column="timestamp">
      <options>
        <option name="unsigned">1</option>
      </options>
    </field>
    <many-to-one field="world" target-entity="FrankProjects\UltimateWarfare\Entity\World">
      <join-columns>
        <join-column name="world_id" nullable="false"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="attacker" target-entity="FrankProjects\UltimateWarfare\Entity\Player" inversed-by="attackerBattleSummaries">
      <join-columns>
        <join-column name="attacker_id" nullable="false"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="defender" target-entity="FrankProjects\UltimateWarfare\Entity\Player" inversed-by="defenderBattleSummaries">
      <join-columns>
        <join-column name="defender_id" nullable="false"/>
      </join-columns>
    </many-to-one>
  </entity>
</doctrine-mapping>
