<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <embeddable name="FrankProjects\UltimateWarfare\Entity\World\MapConfiguration">
    <field name="size" type="integer" column="size">
      <options>
        <option name="unsigned">1</option>
      </options>
    </field>
    <field name="persistence" type="float" column="persistence">
      <options>
        <option name="unsigned">1</option>
      </options>
    </field>
    <field name="seed" type="integer" column="seed">
      <options>
        <option name="unsigned">1</option>
      </options>
    </field>
    <field name="deepWaterLevel" type="integer" column="deep_water_level">
      <options>
        <option name="unsigned">1</option>
        <option name="default">130</option>
      </options>
    </field>
    <field name="waterLevel" type="integer" column="water_level">
      <options>
        <option name="unsigned">1</option>
      </options>
    </field>
    <field name="shallowWaterLevel" type="integer" column="shallow_water_level">
      <options>
        <option name="unsigned">1</option>
        <option name="default">160</option>
      </options>
    </field>
    <field name="sandLevel" type="integer" column="sand_level">
      <options>
        <option name="unsigned">1</option>
        <option name="default">168</option>
      </options>
    </field>
    <field name="grasslandLevel" type="integer" column="grassland_level">
      <options>
        <option name="unsigned">1</option>
        <option name="default">200</option>
      </options>
    </field>
    <field name="forestLevel" type="integer" column="forest_level">
      <options>
        <option name="unsigned">1</option>
        <option name="default">230</option>
      </options>
    </field>
    <field name="hillsLevel" type="integer" column="hills_level">
      <options>
        <option name="unsigned">1</option>
        <option name="default">250</option>
      </options>
    </field>
  </embeddable>
</doctrine-mapping>
